# 0xDriver local secrets and remote runtime settings.
# Copy to .env and fill values locally. Do not commit .env.

# Hugging Face read-only token for downloading SimLingo/model assets.
HF_TOKEN=

# RunPod API key for provisioning/querying GPU instances.
RUNPOD_API_KEY=

# Optional SSH target for a rented GPU instance.
GPU_SSH_HOST=
GPU_SSH_USER=
GPU_SSH_PORT=22
GPU_SSH_KEY_PATH=
# Optional raw SSH options for non-standard providers such as RunPod direct TCP.
# Prefer `python3 -m driverx resolve-runpod-ssh --env-file .env` because
# RunPod public TCP ports change when pods are replaced or restarted.
# Example: -p 55050 -i ~/.ssh/id_ed25519_runpod
GPU_SSH_OPTS=

# Remote runtime paths used by setup/run scripts.
REMOTE_WORKDIR=/workspace/0xDriver
REMOTE_SIMLINGO_ROOT=/workspace/external/simlingo
REMOTE_CARLA_ROOT=/workspace/software/carla0915
REMOTE_MODEL_ROOT=/workspace/models/simlingo

# SimLingo defaults. Override after downloading checkpoint/assets.
SIMLINGO_CHECKPOINT_PATH=/workspace/models/simlingo/simlingo/checkpoints/epoch=013.ckpt/pytorch_model.pt
SIMLINGO_ROUTE_PATH=leaderboard/data/bench2drive_split/bench2drive_00.xml

# CARLA runtime defaults.
CARLA_HOST=127.0.0.1
CARLA_PORT=20000
CARLA_TRAFFIC_MANAGER_PORT=10000
